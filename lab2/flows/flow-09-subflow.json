        "type": "function",
        "z": "subflow_calc",
        "name": "Convert C to F",
        "func": "const celsius = msg.payload;\nconst fahrenheit = (celsius * 1.8) + 32;\nmsg.payload = {\n    processedBy: 'Novickij Subflow',\n    celsius: celsius,\n    fahrenheit: fahrenheit\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
