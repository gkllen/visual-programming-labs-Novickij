        "type": "function",
        "z": "flow2",
        "name": "Process Student Data",
        "func": "const studentName = 'Novickij';\nlet scores = [85, 90, 78, 92];\nlet total = 0;\n\nfor (let i = 0; i < scores.length; i++) {\n    total += scores[i];\n}\n\nlet average = total / scores.length;\nlet status = 'passed';\n\nif (average < 60) {\n    status = 'failed';\n}\n\nmsg.payload = {\n    student: studentName,\n    averageScore: average,\n    status: status,\n    processedAt: new Date().toISOString()\n};\n\nreturn msg;",
