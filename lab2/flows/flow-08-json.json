    {
        "id": "293d3052468aea6c",
        "type": "function",
        "z": "06ae3440dcc73122",
        "name": "Check Query & Items",
        "func": "// Проверяем параметр запроса ?type=...\nconst queryType = msg.req.query.type;\n\nif (queryType === \"all\") {\n    msg.statusCode = 200;\n    msg.payload = [\n        { id: 1, name: \"Node-RED Service\", status: \"active\" },\n        { id: 2, name: \"Mosquitto Broker\", status: \"active\" },\n        { id: 3, name: \"Lab Documentation\", status: \"ready\" }\n    ];\n} else {\n    msg.statusCode = 400;\n    msg.payload = {\n        error: \"Bad Request\",\n        message: \"Missing or invalid 'type' query parameter. Use ?type=all\"\n    };\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
