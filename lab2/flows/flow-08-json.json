        "id": "aff30d49f7fa401a",
        "type": "function",
        "z": "06ae3440dcc73122",
        "name": "Build Info JSON",
        "func": "msg.payload = {\n    status: \"success\",\n    student: \"Novickij\",\n    lab: 2,\n    environment: \"Node-RED on Docker\",\n    serverTime: new Date().toISOString()\n};\nmsg.headers = {\n    \"Content-Type\": \"application/json\"\n};\nreturn msg;",
